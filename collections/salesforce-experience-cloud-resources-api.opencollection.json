{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Experience Cloud Salesforce CMS Connect Actions Resources API",
    "version": "59.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Resources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Experience Cloud List Available Resources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v59.0/connect/cms/"
          },
          "docs": "Returns a list of resources available for the specified API version, providing the name and URI of each resource. Useful for discovering available endpoints."
        }
      ]
    }
  ],
  "bundled": true
}