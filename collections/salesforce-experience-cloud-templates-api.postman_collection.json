          "name": "Salesforce Experience Cloud List Site Templates",
          "request": {
            "name": "Salesforce Experience Cloud List Site Templates",
            "description": {
              "content": "Returns a list of available Experience Cloud site templates that can be used when creating new sites. Includes both standard Salesforce templates (Build Your Own, Customer Service, Partner Central, etc.) and LWR-based templates.",
