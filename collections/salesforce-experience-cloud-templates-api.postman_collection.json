            },
            "url": {
              "path": [
                "connect",
                "communities",
                "templates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "templateCategory",
                  "value": "<string>",
                  "description": "Filter templates by category"
                }
              ],
              "variable": [
                {
                  "description": "Your Salesforce instance name or custom domain",
