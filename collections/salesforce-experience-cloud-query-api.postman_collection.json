            },
            "url": {
              "path": [
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) The SOQL query string to execute"
                }
              ],
              "variable": [
                {
                  "description": "Your Salesforce instance name or custom domain",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
