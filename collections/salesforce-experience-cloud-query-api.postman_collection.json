          "name": "Salesforce Experience Cloud Execute a SOQL Query",
          "request": {
            "name": "Salesforce Experience Cloud Execute a SOQL Query",
            "description": {
              "content": "Executes a SOQL query and returns the matching records. Supports standard SOQL syntax including SELECT, FROM, WHERE, ORDER BY, LIMIT, and OFFSET clauses. Returns paginated results with a nextRecordsUrl for large result sets.",
