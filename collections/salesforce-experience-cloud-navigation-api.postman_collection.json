          "name": "Salesforce Experience Cloud Get Navigation Menu Items",
          "request": {
            "name": "Salesforce Experience Cloud Get Navigation Menu Items",
            "description": {
              "content": "Returns the navigation menu items configured for the specified Experience Cloud site. Includes menu labels, target URLs, access restrictions, and hierarchy structure.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "connect",
                "communities",
                ":communityId",
                "navigation-menu",
                "navigation-menu-items"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "navigationLinkSetId",
                  "value": "<string>",
                  "description": "The ID of the navigation link set to retrieve"
                },
                {
                  "disabled": false,
                  "key": "menuItemTypesToSkip",
                  "value": "<string>",
                  "description": "Comma-separated list of menu item types to exclude"
                },
                {
                  "disabled": false,
                  "key": "publishStatus",
                  "value": "<string>",
                  "description": "Filter by publish status of the navigation menu"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "communityId",
                  "description": "(Required) The ID of the Experience Cloud site (community)"
                },
                {
                  "description": "Your Salesforce instance name or custom domain",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
