{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Experience Cloud Salesforce CMS Connect Actions Content Types API",
    "version": "59.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Content Types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Experience Cloud List Content Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v59.0/connect/cms/content-types",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of items per page (default 25, max 250)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number to retrieve (0-indexed)"
              }
            ]
          },
          "docs": "Returns the CMS content types available in the org, including both standard and custom content types with their field definitions."
        }
      ]
    }
  ],
  "bundled": true
}